{
  "k7x2m9qa": {
        "title": "Grandma's Recipe Box",
    "css": ":root {
	color-scheme: dark;
	--page: #071827;
	--page-glow: #0d243d;
	--surface: #0d2036;
	--surface-strong: #102744;
	--ink: #edf5ff;
	--muted: #a6bbd4;
	--line: rgba(155, 191, 230, 0.18);
	--accent: #7ec4ff;
	--accent-strong: #9ed8ff;
	--accent-soft: rgba(126, 196, 255, 0.16);
	--shadow: rgba(2, 6, 14, 0.56);
}

* {
	box-sizing: border-box;
}

body {
	min-height: 100vh;
	margin: 0;
	display: grid;
	place-items: center;
	padding: 32px 20px;
	background:
		radial-gradient(ellipse at 50% 0%, var(--page-glow), transparent 58%),
		repeating-linear-gradient(135deg, transparent 0 22px, rgba(148, 185, 255, 0.03) 22px 23px),
		linear-gradient(180deg, #091d2d 0%, #050f1a 100%);
	color: var(--ink);
	font-family: "DM Sans", sans-serif;
	transition: background-color 220ms ease, color 220ms ease;
	position: relative;
}

body::before {
	content: "";
	position: absolute;
	inset: 0;
	background: radial-gradient(circle at top, rgba(126, 196, 255, 0.13), transparent 42%);
	pointer-events: none;
}

.profile {
	position: relative;
	width: min(100%, 470px);
	padding: 27px clamp(24px, 7vw, 48px) 23px;
	border: 1px solid var(--line);
	border-radius: 18px;
	background:
		linear-gradient(180deg, rgba(14, 30, 47, 0.98), rgba(9, 21, 34, 0.98));
	box-shadow: 0 24px 80px var(--shadow), inset 0 1px 0 rgba(255, 255, 255, 0.04);
	transition: background-color 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
}

.profile__topline,
.profile__availability {
	display: flex;
	align-items: center;
}

.profile__topline {
	justify-content: space-between;
	gap: 16px;
}

.profile__mark {
	display: grid;
	width: 38px;
	aspect-ratio: 1;
	place-items: center;
	border-radius: 50%;
	background: linear-gradient(135deg, var(--accent-strong), var(--accent));
	color: #071827;
	font-size: 11px;
	font-weight: 800;
	box-shadow: 0 10px 22px rgba(126, 196, 255, 0.28);
}

.profile__availability {
	gap: 9px;
	color: var(--muted);
	font-size: 11px;
	font-weight: 500;
	letter-spacing: 0.04em;
	text-transform: uppercase;
}

.profile__availability span {
	width: 8px;
	aspect-ratio: 1;
	border-radius: 50%;
	background: var(--accent);
	box-shadow: 0 0 0 4px var(--accent-soft);
}

.profile__intro {
	padding: 34px 0 28px;
	text-align: center;
}

.profile__photo {
	width: 104px;
	height: 104px;
	margin-bottom: 17px;
	border: 4px solid var(--surface);
	border-radius: 50%;
	object-fit: cover;
	box-shadow: 0 0 0 1px var(--line), 0 8px 24px var(--shadow);
}

.profile__eyebrow {
	margin: 0 0 5px;
	color: var(--accent);
	font-size: 12px;
	font-weight: 700;
}

h1 {
	margin: 0;
	font-family: "Playfair Display", Georgia, serif;
	font-size: clamp(35px, 10vw, 46px);
	line-height: 1.12;
	font-weight: 600;
}

h1 span {
	color: var(--accent);
}

.profile__bio {
	max-width: 300px;
	margin: 13px auto 0;
	color: var(--muted);
	font-size: 14px;
	line-height: 1.7;
}

.socials {
	border: 1px solid var(--line);
	background: rgba(13, 32, 54, 0.7);
	border-radius: 12px;
	overflow: hidden;
}

.social-link {
	display: grid;
	grid-template-columns: minmax(0, 1fr) auto 18px;
	align-items: center;
	gap: 12px;
	min-height: 55px;
	padding-inline: 14px;
	border-bottom: 1px solid var(--line);
	color: var(--ink);
	font-size: 13px;
	font-weight: 600;
	text-decoration: none;
	transition: color 160ms ease, padding 160ms ease, background 160ms ease;
}

.social-link:last-child {
	border-bottom: 0;
}

.social-link:hover,
.social-link:focus-visible {
	background: rgba(126, 196, 255, 0.06);
	color: var(--accent);
}

.social-link:focus-visible {
	outline: 2px solid var(--accent);
	outline-offset: 3px;
}

.social-link__handle {
	min-width: 0;
	overflow: hidden;
	color: var(--muted);
	font-size: 11px;
	font-weight: 400;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.social-link__arrow {
	color: var(--accent);
	font-size: 17px;
	text-align: right;
}

.profile__footer {
	padding-top: 20px;
	color: var(--muted);
	font-size: 11px;
	text-align: center;
}

.profile__footer span:first-child {
	padding: 0 4px;
	color: var(--accent);
}

@keyframes arrive {
	from { opacity: 0; transform: translateY(12px); }
	to { opacity: 1; transform: translateY(0); }
}

@media (prefers-color-scheme: light) {
	:root {
		color-scheme: light;
		--page: #eaf2fb;
		--page-glow: #edf6ff;
		--surface: #f8fbff;
		--surface-strong: #eaf4ff;
		--ink: #11263c;
		--muted: #5f7590;
		--line: rgba(98, 136, 176, 0.22);
		--accent: #2d74b8;
		--accent-strong: #7ab7f5;
		--accent-soft: rgba(41, 116, 184, 0.12);
		--shadow: rgba(15, 35, 58, 0.12);
	}

	body {
		background:
			radial-gradient(ellipse at 50% 0%, var(--page-glow), transparent 58%),
			repeating-linear-gradient(135deg, transparent 0 22px, rgba(54, 104, 168, 0.04) 22px 23px),
			linear-gradient(180deg, #edf5ff 0%, #e2ebf8 100%);
	}

	.profile {
		background: linear-gradient(180deg, #fdfefe, #f1f7ff);
		box-shadow: 0 24px 80px var(--shadow), inset 0 1px 0 rgba(255, 255, 255, 0.8);
	}

	.socials {
		background: rgba(255, 255, 255, 0.5);
	}
}

@media (max-width: 380px) {
	.profile {
		padding-right: 22px;
		padding-left: 22px;
	}

	.social-link {
		gap: 8px;
	}

	.social-link__handle {
		font-size: 10px;
	}
}

@media (prefers-reduced-motion: reduce) {
	*,
	*::before,
	*::after {
		animation-duration: 0.01ms !important;
		transition-duration: 0.01ms !important;
	}
}
